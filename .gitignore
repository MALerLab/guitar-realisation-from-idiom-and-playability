# Python / uv
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# Node (alphaTab for the GP parser; package-lock.json is tracked)
node_modules/

# Secrets / local env
.env

# Data: symlinks to server-local storage
/data/

# One-off / temporary scripts (promote to src/ once reused)
/scripts/

