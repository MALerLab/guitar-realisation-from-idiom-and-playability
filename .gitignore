/manifests/*.parquet
*.csv

# Docs: only the public ones tracked; papers, survey write-ups and working notes stay local
/docs/*
!/docs/design_spec.md
!/docs/parser_audit.md

# Local notes + worktree setup
/CLAUDE.md
/todo.md
/setup_worktree.sh

# Papers: their own private repo, not tracked here
/papers/
